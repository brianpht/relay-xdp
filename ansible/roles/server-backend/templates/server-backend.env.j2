# server-backend environment - managed by Ansible, do not edit manually.
RUST_LOG={{ rust_log }}
RUST_BACKTRACE={{ rust_backtrace }}
HTTP_PORT={{ server_backend_http_port }}
# relay-backend admin URL for /bench_token + /route_matrix polling.
# relay-backend is co-located on the same host; admin port exposed only on loopback.
RELAY_BACKEND_ADMIN_URL=http://127.0.0.1:{{ backend_admin_http_port | default(backend_http_port | int + 1) }}
POLL_INTERVAL_MS={{ server_backend_poll_interval_ms | default(1000) }}
WEBHOOK_TIMEOUT_MS={{ server_backend_webhook_timeout_ms | default(3000) }}

