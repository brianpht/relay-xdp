[Unit]
Description=relay-xdp - UDP game relay with XDP packet processing
Documentation=https://github.com/{{ github_repo }}
After=network.target relay-module.service
Wants=relay-module.service

[Service]
Type=simple
# relay-xdp requires root / CAP_BPF to attach XDP programs and load eBPF maps.
User=root
Group=root
EnvironmentFile={{ relay_conf_dir }}/relay.env
ExecStart={{ relay_data_dir }}/relay-xdp
Restart=on-failure
RestartSec=10s
TimeoutStartSec=60s
TimeoutStopSec=30s

# Grant only the capabilities required for XDP and BPF map management.
# CAP_NET_ADMIN  - attach XDP to interface, set socket options
# CAP_BPF        - load/pin BPF programs and maps (kernel 5.8+)
# CAP_SYS_ADMIN  - required by some aya operations on older kernels
AmbientCapabilities=CAP_NET_ADMIN CAP_BPF CAP_SYS_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN CAP_BPF CAP_SYS_ADMIN

# P1-06 hardening: restrict the privileged service to the minimum surface.
# `ProtectSystem=strict` makes the entire filesystem read-only except
# /dev, /proc, /sys (BPF map pinning under /sys/fs/bpf still works).
# `RestrictAddressFamilies` keeps inet sockets (UDP/HTTP) and netlink
# (interface enumeration during XDP attach). If a future change writes to
# disk under /var/lib/relay or similar, add `ReadWritePaths=...` rather
# than relaxing ProtectSystem.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=relay-xdp

[Install]
WantedBy=multi-user.target

