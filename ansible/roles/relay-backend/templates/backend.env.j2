# relay-backend environment - managed by Ansible, do not edit manually.
RUST_LOG={{ rust_log }}
RUST_BACKTRACE={{ rust_backtrace }}
HTTP_PORT={{ backend_http_port }}
# Admin / data-plane port - separate from the public HTTP port (P1-14).
# Production security group allows ingress on this port from admin_cidr only;
# the listener binds to 0.0.0.0 here so the SG is the perimeter, not the bind.
ADMIN_HTTP_PORT={{ backend_admin_http_port | default(backend_http_port + 1) }}
ADMIN_BIND_ADDRESS={{ backend_admin_bind_address | default('0.0.0.0') }}
REDIS_HOSTNAME=127.0.0.1:{{ redis_port }}
RELAY_BACKEND_PUBLIC_KEY={{ vault_relay_backend_public_key }}
RELAY_BACKEND_PRIVATE_KEY={{ vault_relay_backend_private_key }}
RELAY_DATA_FILE={{ relay_conf_dir }}/relays.json

